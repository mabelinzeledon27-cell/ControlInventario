@model ControlInventario.Models.Producto

@{
    ViewData["Title"] = "Registrar Producto";
}

<h1>Registrar Producto</h1>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label">
            Nombre del producto
        </label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Stock" class="form-label">
            Cantidad en stock
        </label>
        <input asp-for="Stock" class="form-control" type="number" />
        <span asp-validation-for="Stock" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Precio" class="form-label">
            Precio
        </label>
        <input asp-for="Precio" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ProveedorId" class="form-label">
            Proveedor
        </label>
        <select asp-for="ProveedorId"
                asp-items="ViewBag.ProveedorId"
                class="form-control">
            <option value="">Seleccione un proveedor</option>
        </select>
        <span asp-validation-for="ProveedorId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar producto
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Volver
    </a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
